#!/bin/sh
# This file is licensed under the public domain.
set -eu

if [ "$#" -ne 2 ]; then
    echo "usage: ./build <arch>-<os>-<abi> <cpu>" >&2
    exit 1
fi

target=$1
cpu=$2
source_root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
output_root=${BOOTSTRAP_OUTPUT_ROOT:-"$source_root/out"}
mkdir -p "$output_root"
output_root=$(CDPATH= cd -- "$output_root" && pwd)
host_prefix="$output_root/host"
target_prefix="$output_root/$target-$cpu"

# Each stage also serves the Nix build, which gives it only its declared source
# inputs and an independent build directory. The ordinary build keeps the
# historical combined host and target install locations.
"$source_root/nix/stages/native-llvm.sh" "$source_root" "$output_root/build-llvm-host" "$host_prefix"
"$source_root/nix/stages/host-zig.sh" "$source_root" "$output_root/build-zig-host" "$host_prefix" "$host_prefix"
"$source_root/nix/stages/zlib.sh" "$source_root" "$output_root/build-zlib-$target-$cpu" "$target_prefix" "$host_prefix" "$target" "$cpu"
"$source_root/nix/stages/zstd.sh" "$source_root" "$output_root/build-zstd-$target-$cpu" "$target_prefix" "$host_prefix" "$target" "$cpu"
"$source_root/nix/stages/target-llvm.sh" "$source_root" "$output_root/build-llvm-$target-$cpu" "$target_prefix" "$host_prefix" "$target" "$cpu" "$target_prefix" "$target_prefix"
"$source_root/nix/stages/binaryen.sh" "$source_root" "$output_root/build-binaryen-$target-$cpu" "$target_prefix" "$host_prefix" "$target" "$cpu"

echo "Roc dependencies installed in $target_prefix"
